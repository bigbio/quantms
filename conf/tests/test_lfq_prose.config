/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests (LFQ) with ProSE on Thermo RAW files
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple test of the default
    workflow: Thermo .raw files read directly by OpenMS (no conversion), ProSE search with internal
    Percolator rescoring with PeptDeep (ONNX) predicted features and distributed ProteomicsLFQ feature finding with feature checkpoints.

    Requires an OpenMS image with ONNX Runtime and the PeptDeep models (OpenMS/OpenMS#9975, #10461, #10462)
    and OpenMS/OpenMS#10453 (older ProteomicsLFQ builds refuse to write QPX for ProSE's positional isomers).

    Use as follows:
        nextflow run bigbio/quantms -profile test_lfq_prose,<docker/singularity> [--outdir <OUTDIR>]

----------------------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '12.GB',
        time: '48.h'
    ]
}

params {
    config_profile_name        = 'Test ProSE LFQ profile'
    config_profile_description = 'Minimal test dataset to check direct Thermo RAW reading, ProSE search and distributed LFQ feature finding.'

    outdir = "./results_lfq_prose"

    // Input data
    input = 'https://raw.githubusercontent.com/bigbio/quantms-test-datasets/quantms/testdata/lfq_ci_phospho/test_phospho.sdrf'
    database = 'https://raw.githubusercontent.com/bigbio/quantms-test-datasets/quantms/testdata/lfq_ci_phospho/pools_crap_targetdecoy.fasta'
    search_engines = 'prose'
    prose_peptdeep = true
    convert_raw = false
    lfq_distributed_featurefinding = true
    protein_level_fdr_cutoff = 0.20
    psm_level_fdr_cutoff = 0.50
}
