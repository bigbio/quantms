/*
========================================================================================
    Shared module options — publishDir for outputs used across all workflows
========================================================================================
*/

process {

    // publishDir for pmultiqc reports
    withName: 'BIGBIO_QUANTMS:QUANTMS:SUMMARY_PIPELINE' {
        publishDir = [
            path: { "${params.outdir}/pmultiqc" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // publishDir for SDRF files
    withName: 'BIGBIO_QUANTMS:QUANTMS:INPUT_CHECK:SAMPLESHEET_CHECK' {
        publishDir = [
            path: { "${params.outdir}/sdrf" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // publishDir for configurations files from SDRF parsing
    withName: '.*:SDRF_PARSING' {
        publishDir = [
            path: { "${params.outdir}/sdrf" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ProteomicsLFQ / IsobaricWorkflow: publish ONLY the MSstats input. The
    // consensusXML is an intermediate consumed by QPX_OPENMSCONSENSUS and must NOT
    // be published; the raw OpenMS `-out_qpx` folder is not used at all (it
    // mis-assigns every PSM's run, OpenMS#9872). QPX_OPENMSCONSENSUS's refined QPX
    // (below) is the published quantification artifact.
    withName: '.*:PROTEOMICSLFQ|.*:ISOBARIC_WORKFLOW' {
        publishDir = [
            path: { "${params.outdir}/quant_tables" },
            mode: 'copy',
            saveAs: { filename -> filename.endsWith('msstats_in.csv') ? filename : null }
        ]
    }

    // MSstats converter output
    withName: '.*:MSSTATS_CONVERTER' {
        publishDir = [
            path: { "${params.outdir}/quant_tables" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // The refined QPX (psm/feature/pg + metadata tables + .h5mu MuData) built by
    // the shared `bigbio/qpx/openmsconsensus` module — the pipeline's published
    // quantification artifact (the raw OpenMS `-out_qpx` is not used at all).
    // Published to a dedicated top-level `qpx/` dir (NOT quant_tables), consistent
    // with quantmsdiann's QPX_DIANN.
    withName: '.*:QPX_OPENMSCONSENSUS' {
        publishDir = [
            path: { "${params.outdir}/qpx" },
            mode: 'copy',
            // Flatten: drop the `qpx_output/` prefix so the dataset files + the
            // `.h5mu` land directly under `qpx/` (same layout as quantmsdiann).
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename.tokenize('/').last() }
        ]
    }

    // publishDir for all features tables
    withName: '.*:MZML_STATISTICS' {
        publishDir = [
            path: { "${params.outdir}/spectra/mzml_statistics" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}
