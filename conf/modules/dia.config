/*
========================================================================================
    DIA-NN module options — all DIA pipeline steps
========================================================================================
    Flags already controlled by pipeline params are blocked to prevent silent override
    conflicts. Structural flags (--temp, --threads, --lib, --f, --fasta) are blocked
    in all steps.
----------------------------------------------------------------------------------------
*/

process {

    withName: ".*:DIA:INSILICO_LIBRARY_GENERATION" {
        ext.args   = {
            def extraArgs = params.diann_extra_args ?: ''
            def blocked = ['--use-quant', '--no-main-report', '--matrices', '--out',
                 '--temp', '--threads', '--verbose', '--lib', '--f', '--fasta',
                 '--fasta-search', '--predictor', '--gen-spec-lib',
                 '--missed-cleavages', '--min-pep-len', '--max-pep-len',
                 '--min-pr-charge', '--max-pr-charge', '--var-mods',
                 '--min-pr-mz', '--max-pr-mz', '--min-fr-mz', '--max-fr-mz',
                 '--met-excision']
            blocked.each { flag ->
                if (extraArgs.contains(flag)) {
                    log.warn "DIA-NN extra args: '${flag}' is not compatible with INSILICO_LIBRARY_GENERATION and will be stripped."
                    extraArgs = extraArgs.replaceAll(java.util.regex.Pattern.quote(flag) + '(\\s+(?!--)\\S+)*', '').trim()
                }
            }
            ["--met-excision", extraArgs].join(' ').trim()
        }
    }

    withName: ".*:DIA:PRELIMINARY_ANALYSIS" {
        ext.args   = {
            def extraArgs = params.diann_extra_args ?: ''
            def blocked = ['--use-quant', '--gen-spec-lib', '--out-lib', '--matrices', '--out',
                 '--temp', '--threads', '--verbose', '--lib', '--f',
                 '--mass-acc', '--mass-acc-ms1', '--window']
            blocked.each { flag ->
                if (extraArgs.contains(flag)) {
                    log.warn "DIA-NN extra args: '${flag}' is not compatible with PRELIMINARY_ANALYSIS and will be stripped."
                    extraArgs = extraArgs.replaceAll(java.util.regex.Pattern.quote(flag) + '(\\s+(?!--)\\S+)*', '').trim()
                }
            }
            [params.quick_mass_acc ? "--quick-mass-acc" : '',
             params.performance_mode ? "--min-corr 2 --corr-diff 1 --time-corr-only" : '',
             extraArgs].join(' ').trim()
        }
    }

    withName: ".*:DIA:ASSEMBLE_EMPIRICAL_LIBRARY" {
        ext.args   = {
            def extraArgs = params.diann_extra_args ?: ''
            def blocked = ['--no-main-report', '--no-ifs-removal', '--matrices', '--out',
                 '--temp', '--threads', '--verbose', '--lib', '--f',
                 '--mass-acc', '--mass-acc-ms1', '--window',
                 '--individual-mass-acc', '--individual-windows',
                 '--out-lib', '--use-quant', '--gen-spec-lib', '--rt-profiling']
            blocked.each { flag ->
                if (extraArgs.contains(flag)) {
                    log.warn "DIA-NN extra args: '${flag}' is not compatible with ASSEMBLE_EMPIRICAL_LIBRARY and will be stripped."
                    extraArgs = extraArgs.replaceAll(java.util.regex.Pattern.quote(flag) + '(\\s+(?!--)\\S+)*', '').trim()
                }
            }
            extraArgs
        }
    }

    withName: ".*:DIA:INDIVIDUAL_ANALYSIS" {
        ext.args   = {
            def extraArgs = params.diann_extra_args ?: ''
            def blocked = ['--use-quant', '--gen-spec-lib', '--out-lib', '--matrices', '--out', '--rt-profiling',
                 '--temp', '--threads', '--verbose', '--lib', '--f', '--fasta',
                 '--mass-acc', '--mass-acc-ms1', '--window',
                 '--no-ifs-removal', '--no-main-report', '--relaxed-prot-inf', '--pg-level']
            blocked.each { flag ->
                if (extraArgs.contains(flag)) {
                    log.warn "DIA-NN extra args: '${flag}' is not compatible with INDIVIDUAL_ANALYSIS and will be stripped."
                    extraArgs = extraArgs.replaceAll(java.util.regex.Pattern.quote(flag) + '(\\s+(?!--)\\S+)*', '').trim()
                }
            }
            extraArgs
        }
    }

    withName: ".*:DIA:FINAL_QUANTIFICATION" {
        ext.args   = {
            def extraArgs = params.diann_extra_args ?: ''
            def blocked = ['--no-main-report', '--gen-spec-lib', '--out-lib', '--no-ifs-removal',
                 '--temp', '--threads', '--verbose', '--lib', '--f', '--fasta',
                 '--use-quant', '--matrices', '--out', '--relaxed-prot-inf', '--pg-level',
                 '--qvalue', '--window', '--individual-windows',
                 '--species-genes', '--report-decoys', '--xic']
            blocked.each { flag ->
                if (extraArgs.contains(flag)) {
                    log.warn "DIA-NN extra args: '${flag}' is not compatible with FINAL_QUANTIFICATION and will be stripped."
                    extraArgs = extraArgs.replaceAll(java.util.regex.Pattern.quote(flag) + '(\\s+(?!--)\\S+)*', '').trim()
                }
            }
            extraArgs
        }
    }
}
