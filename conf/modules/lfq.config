/*
========================================================================================
    LFQ module options — LFQ-specific processes
========================================================================================
*/

process {

    // PROTEOMICSLFQ (single task or combining task) and PROTEOMICSLFQ_DETECT (per-run feature detection).
    // Options that shape feature detection must be identical for both; they are set in workflows/lfq.nf.
    withName: '.*:LFQ:PROTEOMICSLFQ' {
        ext.args    = "-debug $params.plfq_debug"
    }

    withName: '.*:LFQ:PROTEOMICSLFQ_DETECT' {
        ext.args    = "-debug $params.plfq_debug"
    }
}
